<UserControl x:Class="L2Toolkit.Views.CreateMultisell"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemeSurfacePage}">

    <UserControl.Resources>
        <ControlTheme x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextButton}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHoverStrong}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfacePressed}"/>
            </Style>
        </ControlTheme>

        <!-- Aba do resultado: sublinhado no ativo (classe "active"), só texto nos demais. -->
        <ControlTheme x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextHint}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            </Style>
            <Style Selector="^.active">
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextTitle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="TextBox.FormField">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelection}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.FormField /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBox.FormField:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.FormField:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHover}"/>
        </Style>

        <Style Selector="TextBox.Code /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.Code:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.Code:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
        </Style>

    </UserControl.Styles>

    <!-- Sem scroll: o resultado ocupa a altura que sobra (linha *). -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

            <!-- ── Page Header ──────────────────────────────────────── -->
            <StackPanel Grid.Row="0" Margin="32,24,32,16" Spacing="3">
                <TextBlock Text="Criar Multisell"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
                <TextBlock Text="Crie bases para multisell de vendas"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
            </StackPanel>

            <!-- ── Aviso: pasta de assets não configurada ───────────── -->
            <Border x:Name="AssetsWarnBorder"
                    Grid.Row="1"
                    Margin="32,0,32,12"
                    Background="{DynamicResource ThemeCautionBg}"
                    BorderBrush="{DynamicResource ThemeCautionBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Cursor="Hand"
                    IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M12 2L1 21h22L12 2zm1 16h-2v-2h2v2zm0-4h-2V9h2v5z" Width="14" Height="14" Foreground="{DynamicResource ThemeCaution}" VerticalAlignment="Center"/>
                    <TextBlock Text="Pasta de assets não configurada."
                               Foreground="{DynamicResource ThemeCaution}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Clique aqui para configurar."
                               Foreground="{DynamicResource ThemeCaution}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextDecorations="Underline"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── Banner de erro ────────────────────────────────────── -->
            <Border x:Name="NotificacaoBorder"
                    Grid.Row="2"
                    Margin="32,0,32,12"
                    Background="{DynamicResource ThemeWarningBg}"
                    BorderBrush="{DynamicResource ThemeWarningBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    IsVisible="False">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Grid.Column="0" Data="M12 2L1 21h22L12 2zm1 16h-2v-2h2v2zm0-4h-2V9h2v5z" Width="14" Height="14" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               x:Name="StatusNotificacao"
                               Foreground="{DynamicResource ThemeWarning}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Painel 01: Dados de Entrada ───────────────────────── -->
            <Border Grid.Row="3" Margin="32,0"
                    CornerRadius="8"
                    Background="{DynamicResource ThemeSurfaceCard}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                    <StackPanel Grid.Column="1">

                        <StackPanel Orientation="Horizontal"
                                    Margin="20,0"
                                    Height="40"
                                    Spacing="14"
                                    VerticalAlignment="Center">
                            <TextBlock Text="DADOS DE ENTRADA"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextLabel}"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource ThemeBorder}"/>

                        <!-- IDs de produção à esquerda, ingredientes à direita -->
                        <Grid Margin="20,12,20,16" ColumnDefinitions="*,14,*">

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="IDs de produção (separados por ; ou intervalo com ...)"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThemeTextLabel}"
                                           FontWeight="Medium"/>
                                <TextBox x:Name="ProductionId"
                                         Classes="FormField"
                                         Height="34"
                                         Padding="12,0"
                                         VerticalContentAlignment="Center"
                                         FontFamily="Consolas,Courier New,monospace"
                                         FontSize="12"
                                         Watermark="Ex: 1000;1001;1002 ou 1000...1050"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="Ingredientes (formato: id;quantidade)"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThemeTextLabel}"
                                           FontWeight="Medium"/>
                                <Grid ColumnDefinitions="*,10,Auto">
                                    <TextBox x:Name="MaterialInput"
                                             Grid.Column="0"
                                             Classes="FormField"
                                             Height="34"
                                             Padding="12,0"
                                             VerticalContentAlignment="Center"
                                             FontFamily="Consolas,Courier New,monospace"
                                             FontSize="12"
                                             Watermark="Ex: 57;500"/>
                                    <Button x:Name="AddIngredientBtn"
                                            Grid.Column="2"
                                            Height="34"
                                            Padding="16,0"
                                            Theme="{StaticResource GhostButton}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <PathIcon Foreground="{DynamicResource ThemeTextLabel}" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Adicionar"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <WrapPanel x:Name="IngredientsPanel" IsVisible="False"/>
                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Ação: Gerar (separador de pipeline) ──────────────── -->
            <Grid Grid.Row="4" Margin="32,12" ColumnDefinitions="*,Auto,*">
                <Border Grid.Column="0"
                        Height="1"
                        Background="{DynamicResource ThemeBorder}"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        x:Name="GenerateData"
                        Click="GenerateData_OnClick"
                        Height="36"
                        Padding="28,0"
                        Margin="20,0"
                        Theme="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <PathIcon Data="M8 5v14l11-7z" Width="14" Height="14" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Gerar MultiSell"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Grid.Column="2"
                        Height="1"
                        Background="{DynamicResource ThemeBorder}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- ── Painel 02: Resultado em abas (uma área de texto por vez) ── -->
            <Border Grid.Row="5" Margin="32,0,32,24"
                    CornerRadius="8"
                    Background="{DynamicResource ThemeSurfaceCard}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

                        <Grid Grid.Row="0" ColumnDefinitions="Auto,18,*,Auto,Auto" Margin="20,0,16,0">
                            <TextBlock Grid.Column="0"
                                       Text="RESULTADO"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextLabel}"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="XmlTab" Classes="active" Theme="{StaticResource TabButton}"
                                        Content="Dados Multisell" Click="ResultTab_OnClick"/>
                                <Button x:Name="LogTab" Theme="{StaticResource TabButton}"
                                        Content="Logs" Click="ResultTab_OnClick"/>
                            </StackPanel>

                            <Border Grid.Column="3"
                                    x:Name="CopiedBadge"
                                    IsVisible="False"
                                    Background="{DynamicResource ThemeSuccessBg}"
                                    BorderBrush="{DynamicResource ThemeSuccessBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Width="10" Height="10" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copiado!"
                                               FontSize="10"
                                               Foreground="{DynamicResource ThemeSuccess}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="4"
                                    x:Name="CopyButton"
                                    Click="Copy_OnClick"
                                    Height="30"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Copia o conteúdo da aba aberta"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Foreground="{DynamicResource ThemeTextLabel}" Width="12" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copiar"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="{DynamicResource ThemeBorder}"/>

                        <!-- Uma área por aba; só a da aba ativa fica visível -->
                        <Panel Grid.Row="2" MinHeight="160">
                            <TextBox x:Name="XmlData"
                                     Classes="Code"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Padding="20,14"
                                     BorderThickness="0"
                                     Background="{DynamicResource ThemeSurfaceInput}"
                                     Foreground="{DynamicResource ThemeTextCode}"
                                     CaretBrush="{DynamicResource ThemeAccent}"
                                     SelectionBrush="{DynamicResource ThemeSelection}"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     Watermark="O XML do multisell aparecerá aqui..."/>
                            <TextBox x:Name="BoxLog"
                                     IsVisible="False"
                                     Classes="Code"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Padding="20,14"
                                     BorderThickness="0"
                                     Background="{DynamicResource ThemeSurfaceInput}"
                                     Foreground="{DynamicResource ThemeTextLog}"
                                     CaretBrush="{DynamicResource ThemeAccent}"
                                     SelectionBrush="{DynamicResource ThemeSelection}"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     Watermark="Logs de processamento aparecerão aqui..."/>
                        </Panel>

                    </Grid>
                </Grid>
            </Border>
    </Grid>
</UserControl>
