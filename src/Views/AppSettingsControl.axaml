<UserControl x:Class="L2Toolkit.Views.AppSettingsControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemeSurfacePage}">

    <UserControl.Resources>
        <ControlTheme x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextButton}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHoverStrong}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfacePressed}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBox.FormField">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelection}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.FormField /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBox.FormField:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.FormField:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHover}"/>
        </Style>

        <!-- Cards compactos: título dentro do card, sem faixa de cabeçalho separada. -->
        <Style Selector="Border.Card">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="TextBlock.CardTitle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextLabel}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextLabel}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.Desc">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextHint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.Chip">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <!-- Linha sob o título do card, de borda a borda (compensa o padding do card). -->
        <Style Selector="Border.Divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="Margin" Value="-20,0"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" Spacing="18">

            <!-- Cabeçalho -->
            <StackPanel Spacing="3">
                <TextBlock Text="{DynamicResource Settings.Title}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
                <TextBlock Text="{DynamicResource Settings.Subtitle}"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
            </StackPanel>

            <!-- Aplicativo + Arquivo de configuração lado a lado -->
            <Grid ColumnDefinitions="340,14,*">
                <Border Grid.Column="0" Classes="Card">
                    <Grid ColumnDefinitions="4,*">
                        <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                        <!-- SharedSizeGroup "AppLabel": Tema, Idioma e Versão alinham a coluna de valor. -->
                        <StackPanel Grid.Column="1" Margin="20,14,20,18" Spacing="12" Grid.IsSharedSizeScope="True">
                            <TextBlock Text="{DynamicResource Settings.ApplicationTitle}" Classes="CardTitle"/>
                            <Border Classes="Divider"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="AppLabel"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Settings.ThemeLabel}" Classes="Label"/>
                                <ComboBox x:Name="ThemeComboBox"
                                          Grid.Column="2"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="ThemeComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource Settings.ThemeDarkItem}"/>
                                    <ComboBoxItem Content="{DynamicResource Settings.ThemeLightItem}"/>
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="AppLabel"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Settings.LanguageLabel}" Classes="Label"/>
                                <ComboBox x:Name="LanguageComboBox"
                                          Grid.Column="2"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="LanguageComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                </ComboBox>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="AppLabel"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Settings.VersionLabel}" Classes="Label"/>
                                <TextBlock x:Name="AppVersionText"
                                           Grid.Column="2"
                                           FontSize="12"
                                           FontFamily="Consolas,Courier New,monospace"
                                           Foreground="{DynamicResource ThemeTextBody}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="CheckUpdatesBtn"
                                        Grid.Column="4"
                                        Height="32"
                                        Padding="12,0"
                                        Theme="{StaticResource GhostButton}"
                                        ToolTip.Tip="{DynamicResource Settings.UpdateCheckTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="13" Height="13" Foreground="{DynamicResource ThemeTextLabel}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Settings.UpdateCheckButton}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="UpdateStatusText" Classes="Desc" IsVisible="False"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Classes="Card">
                    <Grid ColumnDefinitions="4,*">
                        <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                        <StackPanel Grid.Column="1" Margin="20,14,20,18" Spacing="12">
                            <TextBlock Text="{DynamicResource Settings.ConfigFileTitle}" Classes="CardTitle"/>
                            <Border Classes="Divider"/>
                            <TextBlock Classes="Desc" Text="{DynamicResource Settings.ConfigFileHint}"/>
                            <Grid ColumnDefinitions="*,10,Auto,8,Auto">
                                <TextBlock x:Name="ConfigPathText"
                                           Background="Transparent"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThemeTextBody}"
                                           FontFamily="Consolas,Courier New,monospace"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="OpenConfigFolderBtn"
                                        Grid.Column="2"
                                        Height="36"
                                        Padding="12,0"
                                        Theme="{StaticResource GhostButton}"
                                        ToolTip.Tip="{DynamicResource Settings.ConfigFolderTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Width="13" Height="13" Foreground="{DynamicResource ThemeTextLabel}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Settings.ConfigFolderButton}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OpenAppFolderBtn"
                                        Grid.Column="4"
                                        Height="36"
                                        Padding="12,0"
                                        Theme="{StaticResource GhostButton}"
                                        ToolTip.Tip="{DynamicResource Settings.AppFolderTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" Foreground="{DynamicResource ThemeTextLabel}" Width="13" Height="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Settings.AppFolderButton}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Pasta de assets -->
            <Border Classes="Card">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                    <StackPanel Grid.Column="1" Margin="20,14,20,18" Spacing="12">
                        <TextBlock Text="{DynamicResource Settings.AssetsTitle}" Classes="CardTitle"/>
                        <Border Classes="Divider"/>
                        <TextBlock Classes="Desc" Text="{DynamicResource Settings.AssetsHint}"/>
                        <Grid ColumnDefinitions="*,10,Auto,8,Auto">
                            <TextBox x:Name="AssetsDirBox"
                                     Grid.Column="0"
                                     Classes="FormField"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Height="36"
                                     Padding="10,0"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="12"
                                     ToolTip.Tip="{DynamicResource Settings.AssetsPathTip}"
                                     Watermark="{DynamicResource Settings.NoFolderWatermark}"/>
                            <Button x:Name="SelectAssetsBtn"
                                    Grid.Column="2"
                                    Height="36"
                                    Padding="14,0"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Foreground="{DynamicResource ThemeTextLabel}" Width="13" Height="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Common.Browse}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClearAssetsBtn"
                                    Grid.Column="4"
                                    Height="36"
                                    Padding="12,0"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="12" Height="12" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextLabel}"/>
                                    <TextBlock Text="{DynamicResource Settings.ClearButton}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Módulos e arquivos necessários, uma linha cada -->
                        <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,10,Auto">
                            <TextBlock Grid.Row="0" Text="{DynamicResource Settings.AssetsModulesLabel}" Classes="Label"/>
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Border Classes="Chip">
                                    <TextBlock Text="{DynamicResource Nav.PrimeShop}" FontSize="12" Foreground="{DynamicResource ThemeTextButton}"/>
                                </Border>
                                <Border Classes="Chip">
                                    <TextBlock Text="{DynamicResource Nav.SearchIcon}" FontSize="12" Foreground="{DynamicResource ThemeTextButton}"/>
                                </Border>
                                <Border Classes="Chip">
                                    <TextBlock Text="{DynamicResource Nav.CreateMultisell}" FontSize="12" Foreground="{DynamicResource ThemeTextButton}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="{DynamicResource Settings.AssetsRequiredFilesLabel}" Classes="Label"/>
                            <WrapPanel x:Name="FilesStatusPanel" Grid.Row="2" Grid.Column="2" Orientation="Horizontal"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- L2DAT Build -->
            <Border Classes="Card">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeSuccessAccent}"/>
                    <StackPanel Grid.Column="1" Margin="20,14,20,18" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Width="14" Height="14" Foreground="{DynamicResource ThemeSuccessAccent}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Settings.BuildTitle}" Classes="CardTitle"/>
                        </StackPanel>
                        <Border Classes="Divider"/>
                        <TextBlock Classes="Desc" Text="{DynamicResource Settings.BuildHint}"/>

                        <!-- Pastas: rótulo à esquerda, campo e ações na mesma linha -->
                        <Grid ColumnDefinitions="Auto,12,*,8,Auto,8,Auto" RowDefinitions="Auto,10,Auto">
                            <TextBlock Grid.Row="0" Text="{DynamicResource Settings.BuildSourceLabel}" Classes="Label"/>
                            <TextBox x:Name="BuildSourceBox"
                                     Grid.Row="0" Grid.Column="2"
                                     Classes="FormField"
                                     IsReadOnly="True"
                                     Focusable="False"
                                     IsHitTestVisible="False"
                                     VerticalContentAlignment="Center"
                                     Height="36"
                                     Padding="10,0"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="12"
                                     Watermark="{DynamicResource Settings.NoFolderWatermark}"/>
                            <Button x:Name="BuildSelectSourceBtn"
                                    Grid.Row="0" Grid.Column="4"
                                    Height="36"
                                    Padding="14,0"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Foreground="{DynamicResource ThemeTextLabel}" Width="13" Height="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Common.Browse}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BuildClearSourceBtn"
                                    Grid.Row="0" Grid.Column="6"
                                    Height="36"
                                    Padding="12,0"
                                    HorizontalAlignment="Stretch"
                                    Theme="{StaticResource GhostButton}"
                                    ToolTip.Tip="{DynamicResource Settings.BuildSourceClearTip}">
                                <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="12" Height="12" Foreground="{DynamicResource ThemeTextLabel}"/>
                            </Button>

                            <TextBlock Grid.Row="2" Text="{DynamicResource Settings.BuildOutputLabel}" Classes="Label"/>
                            <TextBox x:Name="BuildOutputBox"
                                     Grid.Row="2" Grid.Column="2"
                                     Classes="FormField"
                                     IsReadOnly="True"
                                     Focusable="False"
                                     IsHitTestVisible="False"
                                     VerticalContentAlignment="Center"
                                     Height="36"
                                     Padding="10,0"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="12"
                                     Watermark="{DynamicResource Settings.BuildOutputWatermark}"/>
                            <Button x:Name="BuildSelectOutputBtn"
                                    Grid.Row="2" Grid.Column="4"
                                    Height="36"
                                    Padding="14,0"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Foreground="{DynamicResource ThemeTextLabel}" Width="13" Height="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Common.Browse}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BuildResetOutputBtn"
                                    Grid.Row="2" Grid.Column="6"
                                    Height="36"
                                    Padding="12,0"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z" Foreground="{DynamicResource ThemeTextLabel}" Width="13" Height="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Settings.DefaultButton}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Compressão, filtro e ação na mesma linha -->
                        <Grid ColumnDefinitions="Auto,12,160,20,*,12,Auto">
                            <TextBlock Text="{DynamicResource Settings.CompressionLabel}" Classes="Label"/>
                            <ComboBox x:Name="BuildQualityBox"
                                      Grid.Column="2"
                                      Height="36"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="{DynamicResource Settings.QualityMinimumItem}"/>
                                <ComboBoxItem Content="{DynamicResource Settings.QualityMediumItem}"/>
                                <ComboBoxItem Content="{DynamicResource Settings.QualityHighItem}"/>
                                <ComboBoxItem Content="{DynamicResource Settings.QualityMaximumItem}"/>
                            </ComboBox>
                            <CheckBox x:Name="BuildOnlyRequiredCheckBox"
                                      Grid.Column="4"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource ThemeTextButton}">
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Text="{DynamicResource Settings.BuildOnlyRequiredLabel}"/>
                            </CheckBox>
                            <Button x:Name="BuildBtn"
                                    Grid.Column="6"
                                    Height="36"
                                    Padding="20,0"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Width="14" Height="14" Foreground="{DynamicResource ThemeSuccessAccent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Settings.BuildButton}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Progresso e status (só aparecem durante/depois do build) -->
                        <StackPanel x:Name="BuildProgressPanel" IsVisible="False" Spacing="6">
                            <Grid ColumnDefinitions="*,8,Auto">
                                <ProgressBar x:Name="BuildProgressBar"
                                             Grid.Column="0"
                                             Minimum="0" Maximum="100" Value="0"
                                             Height="6"
                                             Foreground="{DynamicResource ThemeSuccessAccent}"
                                             Background="{DynamicResource ThemeSurfaceInput}"
                                             VerticalAlignment="Center"/>
                                <TextBlock x:Name="BuildProgressLabel"
                                           Grid.Column="2"
                                           Text="0 / 0"
                                           FontSize="11"
                                           Foreground="{DynamicResource ThemeTextHint}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="BuildCurrentFile"
                                       FontSize="11"
                                       FontFamily="Consolas,Courier New,monospace"
                                       Foreground="{DynamicResource ThemeTextHint}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="BuildStatusText"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThemeTextLabel}"
                                   TextWrapping="Wrap"
                                   IsVisible="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
