<Window x:Class="L2Toolkit.Views.BrushVariantsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Variações — Gerador de Brush"
        Width="900" Height="660" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeSurfacePage}">

    <Window.Resources>
        <ControlTheme x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextButton}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHoverStrong}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfacePressed}"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBox.FormField">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox.FormField /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="TextBox.FormField:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="20,18,20,8">

        <!-- Quantidade + ações -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,10,80,10,Auto,*,Auto">
            <TextBlock Text="Quantidade" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource ThemeTextLabel}"/>
            <TextBox x:Name="CountBox" Grid.Column="2" Classes="FormField" Height="36" Padding="10,0"
                     VerticalContentAlignment="Center" ToolTip.Tip="De 1 a 200"/>
            <Button x:Name="GenerateButton" Grid.Column="4" Height="36" Padding="16,0"
                    Theme="{StaticResource SecondaryButton}" Click="Generate_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Foreground="White" Width="13" Height="13" VerticalAlignment="Center"/>
                    <TextBlock Text="Gerar" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="ExportAllButton" Grid.Column="6" Height="36" Padding="16,0"
                    Theme="{StaticResource GhostButton}" Click="ExportAll_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                              Foreground="{DynamicResource ThemeTextLabel}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Exportar todos…" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="2,10,0,12" FontSize="12"
                   Foreground="{DynamicResource ThemeTextHint}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="TilesPanel"/>
        </ScrollViewer>
    </Grid>
</Window>
