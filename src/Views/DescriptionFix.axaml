<UserControl x:Class="L2Toolkit.Views.DescriptionFix"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemeSurfacePage}">

    <UserControl.Resources>
        <ControlTheme x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextButton}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHoverStrong}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfacePressed}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBox.FormField">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelection}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.FormField /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBox.FormField:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.FormField:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHover}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ── Page Header ──────────────────────────────────────── -->
            <StackPanel Margin="32,28,32,24" Spacing="3">
                <TextBlock Text="{DynamicResource DescriptionFix.Title}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
                <TextBlock Text="{DynamicResource DescriptionFix.SubtitleLabel}"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
            </StackPanel>

            <!-- ── Banner de erro ────────────────────────────────────── -->
            <Border x:Name="NotificacaoBorder"
                    Margin="32,0,32,16"
                    Background="{DynamicResource ThemeWarningBg}"
                    BorderBrush="{DynamicResource ThemeWarningBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    IsVisible="False">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Grid.Column="0" Data="M12 2L1 21h22L12 2zm1 16h-2v-2h2v2zm0-4h-2V9h2v5z" Width="14" Height="14" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               x:Name="StatusNotificacao"
                               Foreground="{DynamicResource ThemeWarning}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Banner de sucesso ─────────────────────────────────── -->
            <Border x:Name="SucessoBorder"
                    Margin="32,0,32,16"
                    Background="{DynamicResource ThemeSuccessBgDeep}"
                    BorderBrush="{DynamicResource ThemeSuccessBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    IsVisible="False">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Grid.Column="0" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Width="14" Height="14" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               x:Name="SucessoNotificacao"
                               Foreground="{DynamicResource ThemeSuccess}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Painel 01: Arquivo de entrada ────────────────────── -->
            <Border Margin="32,0"
                    CornerRadius="8"
                    Background="{DynamicResource ThemeSurfaceCard}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                    <StackPanel Grid.Column="1">

                        <StackPanel Orientation="Horizontal"
                                    Margin="20,0"
                                    Height="52"
                                    Spacing="14"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource DescriptionFix.InputFileTitle}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextLabel}"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource ThemeBorder}"/>

                        <Grid Margin="20,16,20,20" ColumnDefinitions="*,12,Auto">
                            <TextBox x:Name="ArquivoSelecionadoTextBox"
                                     Grid.Column="0"
                                     Classes="FormField"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Watermark="{DynamicResource DescriptionFix.EmptyFileWatermark}"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="12"/>
                            <Button x:Name="SelecionarArquivoButton"
                                    Grid.Column="2"
                                    Height="36"
                                    Padding="16,0"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Foreground="{DynamicResource ThemeTextLabel}" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Common.Browse}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Ação: Processar (separador de pipeline) ───────────── -->
            <Grid Margin="32,20" ColumnDefinitions="*,Auto,*">
                <Border Grid.Column="0"
                        Height="1"
                        Background="{DynamicResource ThemeBorder}"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        x:Name="ProcessarButton"
                        Height="40"
                        Padding="28,0"
                        Margin="20,0"
                        Theme="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <PathIcon Data="M8 5v14l11-7z" Width="14" Height="14" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="{DynamicResource DescriptionFix.ProcessButton}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Grid.Column="2"
                        Height="1"
                        Background="{DynamicResource ThemeBorder}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- ── Painel 02: Informações ────────────────────────────── -->
            <Border Margin="32,0,32,32"
                    CornerRadius="8"
                    Background="{DynamicResource ThemeSurfaceCard}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                    <StackPanel Grid.Column="1">

                        <StackPanel Orientation="Horizontal"
                                    Margin="20,0"
                                    Height="52"
                                    Spacing="14"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource DescriptionFix.InfoTitle}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextLabel}"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource ThemeBorder}"/>

                        <StackPanel Margin="20,16,20,20" Spacing="12">

                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="4" Height="4" CornerRadius="2"
                                        Background="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource DescriptionFix.InfoEmbeddedHint}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ThemeTextButton}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="4" Height="4" CornerRadius="2"
                                        Background="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource DescriptionFix.InfoSelectHint}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ThemeTextButton}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="4" Height="4" CornerRadius="2"
                                        Background="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource DescriptionFix.InfoOnlyDescriptionHint}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ThemeTextButton}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="4" Height="4" CornerRadius="2"
                                        Background="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource DescriptionFix.InfoSaveHint}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ThemeTextButton}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
