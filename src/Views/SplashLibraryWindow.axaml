<Window x:Class="L2Toolkit.Views.SplashLibraryWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pasta do client — Splash Screen"
        Width="860" Height="620" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeSurfacePage}">

    <Window.Resources>
        <ControlTheme x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextButton}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHoverStrong}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfacePressed}"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBox.FormField">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox.FormField /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="20,18,20,8">

        <!-- Pasta: clicar no campo escolhe outra; Atualizar relê a atual. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,10,Auto">
            <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                    ToolTip.Tip="Clique para escolher a pasta"
                    PointerPressed="Folder_PointerPressed">
                <TextBox x:Name="FolderBox" Classes="FormField"
                         IsReadOnly="True" Focusable="False" IsHitTestVisible="False"
                         Height="36" Padding="12,0" VerticalContentAlignment="Center"
                         FontFamily="Consolas,Courier New,monospace"
                         Watermark="Clique para selecionar a pasta SysTextures do client..."/>
            </Border>
            <Button x:Name="RefreshButton" Grid.Column="2" Height="36" Padding="16,0"
                    Theme="{StaticResource GhostButton}" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Foreground="{DynamicResource ThemeTextLabel}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Atualizar" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Troca em lote: só em memória até "Salvar todos". -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,8,Auto,8,Auto" Margin="0,12,0,12">
            <TextBlock x:Name="StatusText" Grid.Column="0" Margin="2,0,12,0" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource ThemeTextHint}"
                       Text="Escolha a pasta do client para listar os BMP."/>
            <Button x:Name="ReplaceAllButton" Grid.Column="1" Height="32" Padding="14,0"
                    Theme="{StaticResource GhostButton}" Click="ReplaceAll_Click"
                    ToolTip.Tip="Usa uma imagem em todos os BMP listados, cada um no seu tamanho e formato. Nada é gravado ainda.">
                <TextBlock Text="Trocar todos por imagem…" FontSize="12" FontWeight="Medium"/>
            </Button>
            <Button x:Name="DiscardButton" Grid.Column="3" Height="32" Padding="14,0"
                    Theme="{StaticResource GhostButton}" Click="Discard_Click">
                <TextBlock Text="Descartar" FontSize="12" FontWeight="Medium"/>
            </Button>
            <Button x:Name="SaveAllButton" Grid.Column="5" Height="32" Padding="16,0"
                    Theme="{StaticResource SecondaryButton}" Click="SaveAll_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"
                              Foreground="White" Width="12" Height="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Salvar todos" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="TilesPanel"/>
        </ScrollViewer>
    </Grid>
</Window>
