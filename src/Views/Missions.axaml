<UserControl x:Class="L2Toolkit.Views.Missions"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemeSurfacePage}">

    <UserControl.Resources>
        <ControlTheme x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextButton}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHoverStrong}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfacePressed}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBox.FilePath /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBox.FilePath:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceFieldHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHover}"/>
        </Style>
        <Style Selector="TextBox.FilePath:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
        </Style>

        <Style Selector="TextBox.Code /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.Code:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.Code:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ── Page Header ──────────────────────────────────────── -->
            <StackPanel Margin="32,28,32,24" Spacing="3">
                <TextBlock Text="Missões Diárias"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
                <TextBlock Text="Gera dados de cliente a partir do OneDayReward.xml"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
            </StackPanel>

            <!-- ── Banner de erro ────────────────────────────────────── -->
            <Border x:Name="NotificacaoBorder"
                    Margin="32,0,32,16"
                    Background="{DynamicResource ThemeWarningBg}"
                    BorderBrush="{DynamicResource ThemeWarningBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    IsVisible="False">
                <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Stretch">
                    <PathIcon Grid.Column="0" Data="M12 2L1 21h22L12 2zm1 16h-2v-2h2v2zm0-4h-2V9h2v5z" Width="14" Height="14" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               x:Name="StatusNotificacao"
                               Foreground="{DynamicResource ThemeWarning}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Painel 01: Arquivo XML ────────────────────────────── -->
            <Border Margin="32,0"
                    CornerRadius="8"
                    Background="{DynamicResource ThemeSurfaceCard}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                    <StackPanel Grid.Column="1">

                        <StackPanel Orientation="Horizontal"
                                    Margin="20,0"
                                    Height="52"
                                    Spacing="14"
                                    VerticalAlignment="Center">
                            <TextBlock Text="ARQUIVO XML"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextLabel}"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource ThemeBorder}"/>

                        <Grid Margin="20,16,20,20" ColumnDefinitions="*,12,Auto">
                            <TextBox x:Name="RewardContent"
                                     Grid.Column="0"
                                     Classes="FilePath"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Height="38"
                                     Padding="12,0"
                                     BorderBrush="{DynamicResource ThemeBorder}"
                                     BorderThickness="1"
                                     Background="{DynamicResource ThemeSurfaceInput}"
                                     Foreground="{DynamicResource ThemeTextBody}"
                                     CaretBrush="{DynamicResource ThemeAccent}"
                                     SelectionBrush="{DynamicResource ThemeSelection}"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="12"
                                     Watermark="Selecione o OneDayReward.xml..."/>
                            <Button x:Name="SelecionarArquivoButton"
                                    Grid.Column="2"
                                    Height="38"
                                    Padding="16,0"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Foreground="{DynamicResource ThemeTextLabel}" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Selecionar"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Ação: Gerar (separador de pipeline) ──────────────── -->
            <Grid Margin="32,20" ColumnDefinitions="*,Auto,*">
                <Border Grid.Column="0"
                        Height="1"
                        Background="{DynamicResource ThemeBorder}"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        x:Name="RewardGenerate"
                        Height="40"
                        Padding="28,0"
                        Margin="20,0"
                        Theme="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <PathIcon Foreground="White" Data="M8 5v14l11-7z" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Gerar Dados"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Grid.Column="2"
                        Height="1"
                        Background="{DynamicResource ThemeBorder}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- ── Painel 02: Resultado ──────────────────────────────── -->
            <Border Margin="32,0,32,32"
                    CornerRadius="8"
                    Background="{DynamicResource ThemeSurfaceCard}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                    <StackPanel Grid.Column="1">

                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                              Margin="20,0"
                              Height="52">

                            <TextBlock Grid.Column="2"
                                       Text="RESULTADO"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextLabel}"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"/>

                            <!-- Badge "Copiado!" -->
                            <Border Grid.Column="3"
                                    x:Name="CopyBlock"
                                    IsVisible="False"
                                    Background="{DynamicResource ThemeSuccessBg}"
                                    BorderBrush="{DynamicResource ThemeSuccessBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Width="10" Height="10" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copiado!"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ThemeSuccess}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Copy button -->
                            <Button Grid.Column="4"
                                    x:Name="RewardCopy"
                                    Height="30"
                                    Padding="14,0"
                                    VerticalAlignment="Center"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Foreground="{DynamicResource ThemeTextLabel}" Width="12" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copiar"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </Grid>

                        <Border Height="1" Background="{DynamicResource ThemeBorder}"/>

                        <TextBox x:Name="RewardOutput"
                                 Classes="Code"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="280"
                                 Padding="20,14"
                                 BorderThickness="0"
                                 Background="{DynamicResource ThemeSurfaceInput}"
                                 Foreground="{DynamicResource ThemeTextCode}"
                                 CaretBrush="{DynamicResource ThemeAccent}"
                                 SelectionBrush="{DynamicResource ThemeSelection}"
                                 FontFamily="Consolas,Courier New,monospace"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 Watermark="O resultado aparecerá aqui..."/>

                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
