<Window x:Class="L2Toolkit.Views.SplashComposeWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:L2Toolkit.Views.Controls"
        Title="{DynamicResource SplashCompose.WindowTitle}"
        Width="1100" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeSurfacePage}">

    <Window.Resources>
        <ControlTheme x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextButton}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHoverStrong}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfacePressed}"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBox.FormField">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox.FormField /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBox.FormField:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
        </Style>
        <Style Selector="TextBlock.Section">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextLabel}"/>
        </Style>
        <Style Selector="TextBlock.Field">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextLabel}"/>
        </Style>
        <Style Selector="TextBlock.Value">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
        </Style>
        <Style Selector="TextBlock.Hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextHint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Margin" Value="0,-6,0,-4"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">

        <!-- Prévia: a arte recortada pelo brush sobre o xadrez da transparência -->
        <Border Grid.Row="0" Grid.Column="0" Padding="20" Background="{DynamicResource ThemeSurfaceInput}">
            <Grid>
                <TextBlock x:Name="EmptyText" Classes="Hint" FontSize="13" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Width="380"
                           Text="{DynamicResource SplashCompose.EmptyHint}"/>
                <Grid x:Name="PreviewFrame" IsVisible="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:Checkerboard LightBrush="{DynamicResource ThemeSurfaceCard}"
                                           DarkBrush="{DynamicResource ThemeSurfaceRaised}"/>
                    <Image x:Name="PreviewImage" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Painel -->
        <Border Grid.Row="0" Grid.Column="1" Width="290"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14" Spacing="10">

                    <TextBlock Text="{DynamicResource SplashCompose.ArtSectionTitle}" Classes="Section"/>
                    <Button x:Name="ArtButton" Theme="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch" Height="32" Click="ChooseArt_Click">
                        <TextBlock Text="{DynamicResource SplashCompose.ChooseArtButton}" FontSize="12" FontWeight="Medium"/>
                    </Button>
                    <TextBlock x:Name="ArtText" Classes="Hint"/>

                    <Border Height="1" Background="{DynamicResource ThemeBorder}"/>
                    <TextBlock Text="BRUSH" Classes="Section"/>
                    <Grid ColumnDefinitions="*,8,Auto">
                        <TextBox x:Name="SeedBox" Classes="FormField" Height="32" Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Consolas,Courier New,monospace"
                                 ToolTip.Tip="{DynamicResource SplashCompose.SeedTip}"/>
                        <Button Grid.Column="2" Theme="{StaticResource GhostButton}"
                                Height="32" Padding="12,0" Click="Shuffle_Click">
                            <TextBlock Text="{DynamicResource SplashCompose.ShuffleButton}" FontSize="12" FontWeight="Medium"/>
                        </Button>
                    </Grid>

                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SplashCompose.SpikesLabel}" Classes="Field"/>
                            <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #SpikesSlider.Value, StringFormat={}{0:0}}"/>
                        </Grid>
                        <Slider x:Name="SpikesSlider" Minimum="0" Maximum="100" Value="50"/>
                    </StackPanel>
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SplashCompose.CracksLabel}" Classes="Field"/>
                            <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #CracksSlider.Value, StringFormat={}{0:0}}"/>
                        </Grid>
                        <Slider x:Name="CracksSlider" Minimum="0" Maximum="100" Value="50"/>
                    </StackPanel>
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SplashCompose.ClawsLabel}" Classes="Field"/>
                            <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #ClawsSlider.Value, StringFormat={}{0:0}}"/>
                        </Grid>
                        <Slider x:Name="ClawsSlider" Minimum="0" Maximum="100" Value="50"/>
                    </StackPanel>
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SplashCompose.DebrisLabel}" Classes="Field"/>
                            <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #DebrisSlider.Value, StringFormat={}{0:0}}"/>
                        </Grid>
                        <Slider x:Name="DebrisSlider" Minimum="0" Maximum="100" Value="50"/>
                    </StackPanel>
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SplashCompose.SoftnessLabel}" Classes="Field"/>
                            <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #SoftnessSlider.Value, StringFormat={}{0:0}}"/>
                        </Grid>
                        <Slider x:Name="SoftnessSlider" Minimum="0" Maximum="100" Value="30"/>
                    </StackPanel>
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SplashCompose.SymmetryLabel}" Classes="Field"
                                       ToolTip.Tip="{DynamicResource SplashCompose.SymmetryTip}"/>
                            <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #SymmetrySlider.Value, StringFormat={}{0:0}}"/>
                        </Grid>
                        <Slider x:Name="SymmetrySlider" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource ThemeBorder}"/>
                    <TextBlock Text="{DynamicResource SplashCompose.PositionSectionTitle}" Classes="Section"/>
                    <CheckBox x:Name="FillCheck"
                              FontSize="12"
                              Foreground="{DynamicResource ThemeTextBody}"
                              ToolTip.Tip="{DynamicResource SplashCompose.FillTip}">
                        <TextBlock Text="{DynamicResource SplashCompose.FillLabel}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <StackPanel x:Name="PositionPanel" Spacing="10">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SplashCompose.SizeLabel}" Classes="Field"/>
                            <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #ScaleSlider.Value, StringFormat={}{0:0}%}"/>
                        </Grid>
                        <Slider x:Name="ScaleSlider" Minimum="50" Maximum="160" Value="100"/>
                    </StackPanel>
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SplashCompose.HorizontalLabel}" Classes="Field"/>
                            <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #OffsetXSlider.Value, StringFormat={}{0:0}%}"/>
                        </Grid>
                        <Slider x:Name="OffsetXSlider" Minimum="-30" Maximum="30" Value="0"/>
                    </StackPanel>
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SplashCompose.VerticalLabel}" Classes="Field"/>
                            <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #OffsetYSlider.Value, StringFormat={}{0:0}%}"/>
                        </Grid>
                        <Slider x:Name="OffsetYSlider" Minimum="-30" Maximum="30" Value="0"/>
                    </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource ThemeBorder}"/>
                    <TextBlock Text="{DynamicResource SplashCompose.StrokeSectionTitle}" Classes="Section"/>
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource SplashCompose.StrokeWidthLabel}" Classes="Field"
                                       ToolTip.Tip="{DynamicResource SplashCompose.StrokeWidthTip}"/>
                            <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #StrokeSlider.Value, StringFormat={}{0:0} px}"/>
                        </Grid>
                        <Slider x:Name="StrokeSlider" Minimum="0" Maximum="50" Value="0"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,8,*">
                        <Button x:Name="StrokeColorButton" Theme="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="32" Padding="8,0" Click="StrokeColor_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="StrokeColorSwatch" Width="22" Height="16" CornerRadius="3"
                                        BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"/>
                                <TextBlock x:Name="StrokeColorText" FontFamily="Consolas,Courier New,monospace"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="StrokePositionCombo" Grid.Column="2" Height="32"
                                  HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="{DynamicResource SplashCompose.StrokeOutsideLabel}"/>
                            <ComboBoxItem Content="{DynamicResource SplashCompose.StrokeInsideLabel}"/>
                            <ComboBoxItem Content="{DynamicResource SplashCompose.StrokeCenterLabel}"/>
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource ThemeBorder}"/>
                    <TextBlock Text="{DynamicResource SplashCompose.ShadowSectionTitle}" Classes="Section"/>
                    <CheckBox x:Name="ShadowCheck"
                              FontSize="12"
                              Foreground="{DynamicResource ThemeTextBody}"
                              ToolTip.Tip="{DynamicResource SplashCompose.ShadowTip}">
                        <TextBlock Text="{DynamicResource SplashCompose.ShadowLabel}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <StackPanel x:Name="ShadowPanel" Spacing="10" Opacity="0.4" IsHitTestVisible="False">
                        <Button x:Name="ShadowColorButton" Theme="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="32" Padding="8,0" Click="ShadowColor_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="ShadowColorSwatch" Width="22" Height="16" CornerRadius="3"
                                        BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"/>
                                <TextBlock x:Name="ShadowColorText" FontFamily="Consolas,Courier New,monospace"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource SplashCompose.OpacityLabel}" Classes="Field"/>
                                <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #ShadowOpacitySlider.Value, StringFormat={}{0:0}%}"/>
                            </Grid>
                            <Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="100" Value="60"/>
                        </StackPanel>
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource SplashCompose.HorizontalLabel}" Classes="Field"/>
                                <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #ShadowXSlider.Value, StringFormat={}{0:0} px}"/>
                            </Grid>
                            <Slider x:Name="ShadowXSlider" Minimum="-50" Maximum="50" Value="6"/>
                        </StackPanel>
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource SplashCompose.VerticalLabel}" Classes="Field"/>
                                <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #ShadowYSlider.Value, StringFormat={}{0:0} px}"/>
                            </Grid>
                            <Slider x:Name="ShadowYSlider" Minimum="-50" Maximum="50" Value="6"/>
                        </StackPanel>
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource SplashCompose.BlurLabel}" Classes="Field"/>
                                <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #ShadowBlurSlider.Value, StringFormat={}{0:0} px}"/>
                            </Grid>
                            <Slider x:Name="ShadowBlurSlider" Minimum="0" Maximum="50" Value="12"/>
                        </StackPanel>
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource SplashCompose.SpreadLabel}" Classes="Field"
                                           ToolTip.Tip="{DynamicResource SplashCompose.SpreadTip}"/>
                                <TextBlock Grid.Column="1" Classes="Value" Text="{Binding #ShadowSpreadSlider.Value, StringFormat={}{0:0} px}"/>
                            </Grid>
                            <Slider x:Name="ShadowSpreadSlider" Minimum="0" Maximum="30" Value="0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Rodapé -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16,10"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
                <TextBlock x:Name="StatusText" Grid.Column="0" Classes="Hint" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="ExportButton" Grid.Column="1" Theme="{StaticResource GhostButton}"
                        Height="34" Padding="14,0" Click="Export_Click">
                    <TextBlock Text="{DynamicResource SplashCompose.ExportButton}" FontSize="12" FontWeight="Medium"/>
                </Button>
                <Button x:Name="SendButton" Grid.Column="3" Theme="{StaticResource SecondaryButton}"
                        Height="34" Padding="20,0" Click="Send_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z"
                                  Foreground="White" Width="13" Height="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SplashCompose.SendButton}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Seletor de cor do contorno e da sombra -->
        <Popup x:Name="ColorPickerPopup" IsLightDismissEnabled="True" Placement="Bottom" VerticalOffset="6">
            <Border Background="{DynamicResource ThemeSurfaceInput}" BorderBrush="{DynamicResource ThemeBorderMuted}"
                    BorderThickness="1" CornerRadius="10" Padding="14" BoxShadow="0 8 32 4 #AA000000">
                <controls:HsvColorPicker x:Name="ColorPicker"/>
            </Border>
        </Popup>
    </Grid>
</Window>
