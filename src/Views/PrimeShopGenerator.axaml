<UserControl x:Class="L2Toolkit.Views.PrimeShopGenerator"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemeSurfacePage}">

    <UserControl.Resources>
        <ControlTheme x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextButton}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHoverStrong}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfacePressed}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="TextBox.FormField">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelection}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurfaceHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.FormField /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBox.FormField:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
        </Style>
        <Style Selector="TextBox.FormField:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHover}"/>
        </Style>

        <Style Selector="TextBox.Code /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.Code:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.Code:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
        </Style>

        <!-- ComboBox dark theme -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurfaceHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHover}"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceItemHover}"/>
        </Style>

    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ── Page Header ──────────────────────────────────────── -->
            <StackPanel Margin="32,28,32,16" Spacing="3">
                <TextBlock Text="Prime Shop Generator"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
                <TextBlock Text="Configure e gere produtos para a Prime Shop"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
            </StackPanel>

            <!-- ── Aviso: pasta de assets não configurada ───────────── -->
            <Border x:Name="AssetsWarnBorder"
                    Margin="32,0,32,12"
                    Background="{DynamicResource ThemeCautionBg}"
                    BorderBrush="{DynamicResource ThemeCautionBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Cursor="Hand"
                    IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M12 2L1 21h22L12 2zm1 16h-2v-2h2v2zm0-4h-2V9h2v5z" Width="14" Height="14" Foreground="{DynamicResource ThemeCaution}" VerticalAlignment="Center"/>
                    <TextBlock Text="Pasta de assets não configurada."
                               Foreground="{DynamicResource ThemeCaution}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Clique aqui para configurar."
                               Foreground="{DynamicResource ThemeCaution}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextDecorations="Underline"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── Banner de notificação (condicional) ───────────────── -->
            <Border x:Name="NotificacaoBorder"
                    Margin="32,0,32,16"
                    Background="{DynamicResource ThemeWarningBg}"
                    BorderBrush="{DynamicResource ThemeWarningBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    IsVisible="False">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Grid.Column="0" Data="M12 2L1 21h22L12 2zm1 16h-2v-2h2v2zm0-4h-2V9h2v5z" Width="14" Height="14" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               x:Name="StatusNotificacao"
                               Foreground="{DynamicResource ThemeWarning}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Painel 01: Configuração ───────────────────────────── -->
            <Border Margin="32,0"
                    CornerRadius="8"
                    Background="{DynamicResource ThemeSurfaceCard}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                    <StackPanel Grid.Column="1">

                        <StackPanel Orientation="Horizontal"
                                    Margin="20,0"
                                    Height="52"
                                    Spacing="14"
                                    VerticalAlignment="Center">
                            <TextBlock Text="CONFIGURAÇÃO"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextLabel}"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource ThemeBorder}"/>

                        <StackPanel Margin="20,16,20,20" Spacing="16">

                            <!-- IDs -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="IDs dos itens"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource ThemeTextLabel}"/>
                                <TextBox x:Name="IdsTextBox"
                                         Classes="FormField"
                                         Watermark="ex: 57;35;36;37 (separados por ponto e vírgula)"/>
                            </StackPanel>

                            <!-- Categoria + Tipo -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Categoria"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ThemeTextLabel}"/>
                                    <ComboBox x:Name="CategoryComboBox"
                                              ItemContainerTheme="{StaticResource ComboBoxItemTheme}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Tipo"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ThemeTextLabel}"/>
                                    <ComboBox x:Name="TypeComboBox"
                                              ItemContainerTheme="{StaticResource ComboBoxItemTheme}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Preço + Quantidade -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Preço"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ThemeTextLabel}"/>
                                    <TextBox x:Name="PriceTextBox"
                                             Classes="FormField"
                                             Watermark="ex: 1000"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Quantidade"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ThemeTextLabel}"/>
                                    <TextBox x:Name="QuantidadeTextBox"
                                             Classes="FormField"
                                             Text="1"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Ação: Gerar (separador de pipeline) ──────────────── -->
            <Grid Margin="32,20" ColumnDefinitions="*,Auto,*">
                <Border Grid.Column="0"
                        Height="1"
                        Background="{DynamicResource ThemeBorder}"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        x:Name="GerarButton"
                        Height="40"
                        Padding="28,0"
                        Margin="20,0"
                        Theme="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <PathIcon Foreground="White" Data="M8 5v14l11-7z" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Gerar"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Grid.Column="2"
                        Height="1"
                        Background="{DynamicResource ThemeBorder}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- ── Outputs 02 + 03 lado a lado ──────────────────────── -->
            <Grid Margin="32,0" ColumnDefinitions="*,16,*">

                <!-- Painel 02: Cliente -->
                <Border Grid.Column="0"
                        CornerRadius="8"
                        Background="{DynamicResource ThemeSurfaceCard}"
                        BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="4,*">
                        <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                        <StackPanel Grid.Column="1">

                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                  Margin="16,0"
                                  Height="48">
                                <TextBlock Grid.Column="2"
                                           Text="CLIENTE"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeTextLabel}"
                                           LetterSpacing="1.5"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="3"
                                        x:Name="ClienteCopiadoTextBlock"
                                        IsVisible="False"
                                        Background="{DynamicResource ThemeSuccessBg}"
                                        BorderBrush="{DynamicResource ThemeSuccessBorder}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Width="10" Height="10" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Copiado!"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource ThemeSuccess}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="4"
                                        x:Name="CopiarClienteButton"
                                        Height="28"
                                        Padding="12,0"
                                        VerticalAlignment="Center"
                                        Theme="{StaticResource GhostButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Foreground="{DynamicResource ThemeTextLabel}" Width="12" Height="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Copiar"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource ThemeBorder}"/>

                            <TextBlock Text="ProductName_Classic-eu.dat"
                                       FontSize="10"
                                       Foreground="{DynamicResource ThemeTextOutput}"
                                       Margin="15 5"
                                       FontFamily="Consolas,Courier New,monospace"/>

                            <TextBox x:Name="ClientTextBox"
                                     Classes="Code"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="180"
                                     Padding="16,10"
                                     BorderThickness="0"
                                     Background="{DynamicResource ThemeSurfaceInput}"
                                     Foreground="{DynamicResource ThemeTextCode}"
                                     CaretBrush="{DynamicResource ThemeAccent}"
                                     SelectionBrush="{DynamicResource ThemeSelection}"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="11"
                                     IsReadOnly="True"
                                     Watermark="Saída do cliente aparecerá aqui..."/>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Painel 03: Servidor -->
                <Border Grid.Column="2"
                        CornerRadius="8"
                        Background="{DynamicResource ThemeSurfaceCard}"
                        BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="4,*">
                        <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                        <StackPanel Grid.Column="1">

                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                  Margin="16,0"
                                  Height="48">
                                <TextBlock Grid.Column="2"
                                           Text="SERVIDOR"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeTextLabel}"
                                           LetterSpacing="1.5"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="3"
                                        x:Name="ServidorCopiadoTextBlock"
                                        IsVisible="False"
                                        Background="{DynamicResource ThemeSuccessBg}"
                                        BorderBrush="{DynamicResource ThemeSuccessBorder}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Width="10" Height="10" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Copiado!"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource ThemeSuccess}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="4"
                                        x:Name="CopiarServidorButton"
                                        Height="28"
                                        Padding="12,0"
                                        VerticalAlignment="Center"
                                        Theme="{StaticResource GhostButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Foreground="{DynamicResource ThemeTextLabel}" Width="12" Height="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Copiar"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource ThemeBorder}"/>

                            <TextBlock Text="prime_shop.xml"
                                       FontSize="10"
                                       Foreground="{DynamicResource ThemeTextOutput}"
                                       Margin="15 5"
                                       FontFamily="Consolas,Courier New,monospace"/>

                            <TextBox x:Name="ServerTextBox"
                                     Classes="Code"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="180"
                                     Padding="16,10"
                                     BorderThickness="0"
                                     Background="{DynamicResource ThemeSurfaceInput}"
                                     Foreground="{DynamicResource ThemeTextCode}"
                                     CaretBrush="{DynamicResource ThemeAccent}"
                                     SelectionBrush="{DynamicResource ThemeSelection}"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="11"
                                     IsReadOnly="True"
                                     Watermark="Saída do servidor aparecerá aqui..."/>

                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

            <!-- ── Painel 04: Logs ───────────────────────────────────── -->
            <Border Margin="32,16,32,32"
                    CornerRadius="8"
                    Background="{DynamicResource ThemeSurfaceCard}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                    <StackPanel Grid.Column="1">

                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                              Margin="20,0"
                              Height="52">
                            <TextBlock Grid.Column="2"
                                       Text="LOGS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextLabel}"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="3"
                                    x:Name="ItensCopiadoTextBlock"
                                    IsVisible="False"
                                    Background="{DynamicResource ThemeSuccessBg}"
                                    BorderBrush="{DynamicResource ThemeSuccessBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Width="10" Height="10" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copiado!"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ThemeSuccess}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="4"
                                    x:Name="CopiarItensButton"
                                    Height="30"
                                    Padding="14,0"
                                    VerticalAlignment="Center"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Foreground="{DynamicResource ThemeTextLabel}" Width="12" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copiar"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource ThemeBorder}"/>

                        <TextBox x:Name="ItemsGeneratedTextBox"
                                 Classes="Code"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="140"
                                 Padding="20,14"
                                 BorderThickness="0"
                                 Background="{DynamicResource ThemeSurfaceInput}"
                                 Foreground="{DynamicResource ThemeTextBody}"
                                 CaretBrush="{DynamicResource ThemeAccent}"
                                 SelectionBrush="{DynamicResource ThemeSelection}"
                                 FontFamily="Consolas,Courier New,monospace"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 Watermark="IDs e nomes gerados aparecerão aqui..."/>

                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
