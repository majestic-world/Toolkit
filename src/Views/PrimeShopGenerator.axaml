<UserControl x:Class="L2Toolkit.Views.PrimeShopGenerator"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemeSurfacePage}">

    <UserControl.Resources>
        <ControlTheme x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextButton}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHoverStrong}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource ThemeSurfacePressed}"/>
            </Style>
        </ControlTheme>

        <!-- Aba do resultado: sublinhado no ativo (classe "active"), só texto nos demais. -->
        <ControlTheme x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextHint}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            </Style>
            <Style Selector="^.active">
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextTitle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="TextBox.FormField">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelection}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurfaceHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.FormField /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBox.FormField:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
        </Style>
        <Style Selector="TextBox.FormField:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHover}"/>
        </Style>

        <Style Selector="TextBox.Code /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.Code:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.Code:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
        </Style>

        <!-- ComboBox dark theme -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurfaceHover}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHover}"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceItemHover}"/>
        </Style>

    </UserControl.Styles>

    <!-- Sem scroll: o resultado ocupa a altura que sobra (linha *). -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

            <!-- ── Page Header ──────────────────────────────────────── -->
            <StackPanel Grid.Row="0" Margin="32,24,32,16" Spacing="3">
                <TextBlock Text="Prime Shop Generator"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
                <TextBlock Text="{DynamicResource PrimeShop.SubtitleLabel}"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextTitle}"/>
            </StackPanel>

            <!-- ── Aviso: pasta de assets não configurada ───────────── -->
            <Border x:Name="AssetsWarnBorder"
                    Grid.Row="1"
                    Margin="32,0,32,12"
                    Background="{DynamicResource ThemeCautionBg}"
                    BorderBrush="{DynamicResource ThemeCautionBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Cursor="Hand"
                    IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M12 2L1 21h22L12 2zm1 16h-2v-2h2v2zm0-4h-2V9h2v5z" Width="14" Height="14" Foreground="{DynamicResource ThemeCaution}" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource PrimeShop.AssetsMissingStatus}"
                               Foreground="{DynamicResource ThemeCaution}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource PrimeShop.AssetsConfigureHint}"
                               Foreground="{DynamicResource ThemeCaution}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextDecorations="Underline"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── Banner de notificação (condicional) ───────────────── -->
            <Border x:Name="NotificacaoBorder"
                    Grid.Row="2"
                    Margin="32,0,32,12"
                    Background="{DynamicResource ThemeWarningBg}"
                    BorderBrush="{DynamicResource ThemeWarningBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    IsVisible="False">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Grid.Column="0" Data="M12 2L1 21h22L12 2zm1 16h-2v-2h2v2zm0-4h-2V9h2v5z" Width="14" Height="14" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               x:Name="StatusNotificacao"
                               Foreground="{DynamicResource ThemeWarning}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Painel 01: Configuração ───────────────────────────── -->
            <Border Grid.Row="3" Margin="32,0"
                    CornerRadius="8"
                    Background="{DynamicResource ThemeSurfaceCard}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                    <StackPanel Grid.Column="1">

                        <StackPanel Orientation="Horizontal"
                                    Margin="20,0"
                                    Height="40"
                                    Spacing="14"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource PrimeShop.SettingsTitle}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextLabel}"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource ThemeBorder}"/>

                        <StackPanel Margin="20,12,20,16" Spacing="10">

                            <!-- IDs -->
                            <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource PrimeShop.IdsLabel}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ThemeTextLabel}"/>
                                <TextBox x:Name="IdsTextBox"
                                         Classes="FormField"
                                         Height="34"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         Watermark="{DynamicResource PrimeShop.IdsWatermark}"/>
                            </StackPanel>

                            <!-- Categoria, Tipo, Preço e Quantidade na mesma linha -->
                            <Grid ColumnDefinitions="*,14,*,14,*,14,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{DynamicResource PrimeShop.CategoryLabel}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ThemeTextLabel}"/>
                                    <ComboBox x:Name="CategoryComboBox"
                                              Height="34"
                                              VerticalContentAlignment="Center"
                                              ItemContainerTheme="{StaticResource ComboBoxItemTheme}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="{DynamicResource PrimeShop.TypeLabel}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ThemeTextLabel}"/>
                                    <ComboBox x:Name="TypeComboBox"
                                              Height="34"
                                              VerticalContentAlignment="Center"
                                              ItemContainerTheme="{StaticResource ComboBoxItemTheme}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="6">
                                    <TextBlock Text="{DynamicResource PrimeShop.PriceLabel}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ThemeTextLabel}"/>
                                    <TextBox x:Name="PriceTextBox"
                                             Classes="FormField"
                                             Height="34"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Watermark="{DynamicResource PrimeShop.PriceWatermark}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6" Spacing="6">
                                    <TextBlock Text="{DynamicResource PrimeShop.QuantityLabel}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource ThemeTextLabel}"/>
                                    <TextBox x:Name="QuantidadeTextBox"
                                             Classes="FormField"
                                             Height="34"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Text="1"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Ação: Gerar (separador de pipeline) ──────────────── -->
            <Grid Grid.Row="4" Margin="32,12" ColumnDefinitions="*,Auto,*">
                <Border Grid.Column="0"
                        Height="1"
                        Background="{DynamicResource ThemeBorder}"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        x:Name="GerarButton"
                        Height="36"
                        Padding="28,0"
                        Margin="20,0"
                        Theme="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <PathIcon Foreground="White" Data="M8 5v14l11-7z" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource PrimeShop.GenerateButton}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Grid.Column="2"
                        Height="1"
                        Background="{DynamicResource ThemeBorder}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- ── Painel 02: Resultado em abas (uma área de texto por vez) ── -->
            <Border Grid.Row="5" Margin="32,0,32,24"
                    CornerRadius="8"
                    Background="{DynamicResource ThemeSurfaceCard}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="4,*">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}"/>
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

                        <Grid Grid.Row="0" ColumnDefinitions="Auto,18,*,Auto,Auto" Margin="20,0,16,0">
                            <TextBlock Grid.Column="0"
                                       Text="{DynamicResource PrimeShop.ResultTitle}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeTextLabel}"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"/>

                            <!-- Abas: cada uma mostra o arquivo de destino ao lado do nome -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="ClientTab" Classes="active" Theme="{StaticResource TabButton}" Click="ResultTab_OnClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{DynamicResource PrimeShop.ClientTabButton}" VerticalAlignment="Center"/>
                                        <TextBlock Text="ProductName_Classic-eu.dat"
                                                   FontSize="10"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource ThemeTextOutput}"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ServerTab" Theme="{StaticResource TabButton}" Click="ResultTab_OnClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{DynamicResource PrimeShop.ServerTabButton}" VerticalAlignment="Center"/>
                                        <TextBlock Text="prime_shop.xml"
                                                   FontSize="10"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource ThemeTextOutput}"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LogsTab" Theme="{StaticResource TabButton}" Click="ResultTab_OnClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{DynamicResource PrimeShop.LogsTabButton}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="3"
                                    x:Name="CopiedBadge"
                                    IsVisible="False"
                                    Background="{DynamicResource ThemeSuccessBg}"
                                    BorderBrush="{DynamicResource ThemeSuccessBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Width="10" Height="10" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Common.CopiedStatus}"
                                               FontSize="10"
                                               Foreground="{DynamicResource ThemeSuccess}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="4"
                                    x:Name="CopyButton"
                                    Click="Copy_OnClick"
                                    Height="30"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{DynamicResource PrimeShop.CopyTip}"
                                    Theme="{StaticResource GhostButton}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Foreground="{DynamicResource ThemeTextLabel}" Width="12" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Common.Copy}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="{DynamicResource ThemeBorder}"/>

                        <!-- Uma área por aba; só a da aba ativa fica visível -->
                        <Panel Grid.Row="2" MinHeight="160">
                            <TextBox x:Name="ClientTextBox"
                                     Classes="Code"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Padding="20,14"
                                     BorderThickness="0"
                                     Background="{DynamicResource ThemeSurfaceInput}"
                                     Foreground="{DynamicResource ThemeTextCode}"
                                     CaretBrush="{DynamicResource ThemeAccent}"
                                     SelectionBrush="{DynamicResource ThemeSelection}"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="11"
                                     IsReadOnly="True"
                                     Watermark="{DynamicResource PrimeShop.ClientWatermark}"/>
                            <TextBox x:Name="ServerTextBox"
                                     IsVisible="False"
                                     Classes="Code"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Padding="20,14"
                                     BorderThickness="0"
                                     Background="{DynamicResource ThemeSurfaceInput}"
                                     Foreground="{DynamicResource ThemeTextCode}"
                                     CaretBrush="{DynamicResource ThemeAccent}"
                                     SelectionBrush="{DynamicResource ThemeSelection}"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="11"
                                     IsReadOnly="True"
                                     Watermark="{DynamicResource PrimeShop.ServerWatermark}"/>
                            <TextBox x:Name="ItemsGeneratedTextBox"
                                     IsVisible="False"
                                     Classes="Code"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Padding="20,14"
                                     BorderThickness="0"
                                     Background="{DynamicResource ThemeSurfaceInput}"
                                     Foreground="{DynamicResource ThemeTextBody}"
                                     CaretBrush="{DynamicResource ThemeAccent}"
                                     SelectionBrush="{DynamicResource ThemeSelection}"
                                     FontFamily="Consolas,Courier New,monospace"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     Watermark="{DynamicResource PrimeShop.LogsWatermark}"/>
                        </Panel>

                    </Grid>
                </Grid>
            </Border>
    </Grid>
</UserControl>
