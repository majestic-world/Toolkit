<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Paleta do app por tema. Views usam {DynamicResource Theme*}; o código usa AppTheme.Brush("Theme*").
       Dark é o padrão (valores originais); Light espelha cada papel. Novas cores entram aqui, nos dois temas. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="ThemeSurfacePage" Color="#333333"/>
      <SolidColorBrush x:Key="ThemeSurfaceChrome" Color="#2A2A2A"/>
      <SolidColorBrush x:Key="ThemeSurfaceCard" Color="#2C2C2C"/>
      <SolidColorBrush x:Key="ThemeSurfaceInput" Color="#252525"/>
      <SolidColorBrush x:Key="ThemeSurfacePressed" Color="#282828"/>
      <SolidColorBrush x:Key="ThemeSurfaceSave" Color="#303030"/>
      <SolidColorBrush x:Key="ThemeSurfaceRaised" Color="#3A3A3A"/>
      <SolidColorBrush x:Key="ThemeSurfaceHover" Color="#3C3C3C"/>
      <SolidColorBrush x:Key="ThemeSurfaceSelected" Color="#3F3F3F"/>
      <SolidColorBrush x:Key="ThemeSurfaceItemHover" Color="#414141"/>
      <SolidColorBrush x:Key="ThemeSurfaceFieldHover" Color="#404040"/>
      <SolidColorBrush x:Key="ThemeSurfaceActive" Color="#484848"/>
      <SolidColorBrush x:Key="ThemeSurfaceActiveAlt" Color="#4B4B4B"/>
      <SolidColorBrush x:Key="ThemeSurfaceInputHover" Color="#212121"/>
      <SolidColorBrush x:Key="ThemeSurfaceInputFocus" Color="#1C1C1C"/>
      <SolidColorBrush x:Key="ThemeOverlay" Color="#CC000000"/>
      <SolidColorBrush x:Key="ThemeBorder" Color="#464646"/>
      <SolidColorBrush x:Key="ThemeBorderMuted" Color="#505050"/>
      <SolidColorBrush x:Key="ThemeBorderStrong" Color="#6A6A6A"/>
      <SolidColorBrush x:Key="ThemeBorderHover" Color="#707070"/>
      <SolidColorBrush x:Key="ThemeBorderHoverStrong" Color="#808080"/>
      <SolidColorBrush x:Key="ThemeBorderSave" Color="#606060"/>
      <SolidColorBrush x:Key="ThemeBorderChrome" Color="#222222"/>
      <SolidColorBrush x:Key="ThemeTextTitle" Color="#E8E8E8"/>
      <SolidColorBrush x:Key="ThemeTextOutput" Color="#E1E1E1"/>
      <SolidColorBrush x:Key="ThemeTextBody" Color="#D4D4D4"/>
      <SolidColorBrush x:Key="ThemeTextButton" Color="#C8C8C8"/>
      <SolidColorBrush x:Key="ThemeTextIcon" Color="#C0C0C0"/>
      <SolidColorBrush x:Key="ThemeTextLabel" Color="#B8B8B8"/>
      <SolidColorBrush x:Key="ThemeTextBadge" Color="#B4B4B4"/>
      <SolidColorBrush x:Key="ThemeTextSubtitle" Color="#B8BEC8"/>
