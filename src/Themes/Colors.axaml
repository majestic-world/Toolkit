      <SolidColorBrush x:Key="ThemeAccentSelected" Color="#2A4A6A"/>
      <SolidColorBrush x:Key="ThemeAccentSelectedHover" Color="#3A5A7A"/>
      <SolidColorBrush x:Key="ThemeAccentTint" Color="#162840"/>
      <SolidColorBrush x:Key="ThemeAccentTintHover" Color="#1E3049"/>
      <SolidColorBrush x:Key="ThemeAccentTintStrong" Color="#243A54"/>
      <SolidColorBrush x:Key="ThemeSuccess" Color="#52C97A"/>
      <SolidColorBrush x:Key="ThemeSuccessBg" Color="#142B1A"/>
      <SolidColorBrush x:Key="ThemeSuccessBorder" Color="#245230"/>
