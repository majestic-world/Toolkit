      <SolidColorBrush x:Key="ThemeTextButton" Color="#3A3A3A"/>
      <SolidColorBrush x:Key="ThemeTextIcon" Color="#4A4A4A"/>
      <SolidColorBrush x:Key="ThemeTextLabel" Color="#555555"/>
      <SolidColorBrush x:Key="ThemeTextBadge" Color="#555555"/>
      <SolidColorBrush x:Key="ThemeTextSubtitle" Color="#4B5563"/>
